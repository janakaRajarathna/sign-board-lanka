<%
  var isOwner = user && user.role === 'OWNER';
  var consoleName = isOwner ? 'Owner Console' : 'PM Console';
  var iconName = isOwner ? 'view_in_ar' : 'precision_manufacturing';
  var currentPath = typeof activePath === 'string' ? activePath : '';
  var dashActive = currentPath === 'dashboard';
  var projectsActive = currentPath === 'projects' || currentPath === 'projects-detail';
%>
<body class="bg-surface font-body-md text-on-surface antialiased">
<!-- Mobile Backdrop -->
<div class="fixed inset-0 bg-surface-container-lowest/80 backdrop-blur-sm z-40 hidden transition-opacity lg:hidden" id="mobileDrawerBackdrop" onclick="toggleMobileMenu()"></div>
<!-- ASIDE / NAVIGATION DRAWER -->
<aside class="fixed left-0 top-0 h-full w-72 bg-surface-container-lowest border-r border-outline-variant/30 z-50 flex flex-col justify-between select-none transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out" id="sidebarDrawer">
  <div class="flex flex-col flex-1 min-h-0">
    <div class="h-16 px-space-md border-b border-outline-variant/30 flex items-center justify-between bg-surface-container-lowest">
      <div class="flex items-center gap-space-sm min-w-0">
        <div class="w-9 h-9 bg-primary-container flex items-center justify-center text-on-primary-container font-headline-sm text-headline-sm border border-primary/40 shrink-0">
          <span class="material-symbols-outlined text-[20px]"><%= iconName %></span>
        </div>
        <div class="flex flex-col justify-center min-w-0">
          <div class="flex items-center gap-space-xs">
            <span class="font-headline-sm text-headline-sm text-on-surface tracking-tight truncate">SIGN BOARD</span>
            <span class="font-label-sm text-label-sm text-primary uppercase">LKA</span>
          </div>
          <span class="font-label-sm text-label-sm text-on-surface-variant truncate uppercase tracking-wider"><%= consoleName %></span>
        </div>
      </div>
      <button aria-label="Close menu" class="p-space-xs text-outline hover:text-on-surface lg:hidden cursor-pointer" onclick="toggleMobileMenu()" type="button">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto px-space-sm py-space-sm space-y-space-xs">
      <nav class="space-y-space-xs" data-active-classes="bg-primary-container text-on-primary-container font-semibold border-l-2 border-primary">
        <a class="flex items-center gap-space-sm px-space-sm py-2 transition-colors <%= dashActive ? 'bg-primary-container text-on-primary-container font-semibold border-l-2 border-primary' : 'text-on-surface-variant hover:bg-surface-container hover:text-on-surface' %>"
           href="/dashboard"
           <% if (dashActive) { %>aria-current="page"<% } %>>
          <span class="material-symbols-outlined text-[18px]">dashboard</span>
          <span class="font-body-md text-body-md">Dashboard</span>
        </a>
        <a class="flex items-center gap-space-sm px-space-sm py-2 transition-colors <%= projectsActive ? 'bg-primary-container text-on-primary-container font-semibold border-l-2 border-primary' : 'text-on-surface-variant hover:bg-surface-container hover:text-on-surface' %>"
           href="/projects"
           <% if (projectsActive) { %>aria-current="page"<% } %>>
          <span class="material-symbols-outlined text-[18px]">assignment</span>
          <span class="font-body-md text-body-md"><%= isOwner ? 'Projects' : 'My Projects' %></span>
        </a>
      </nav>
    </div>
  </div>
  <div class="p-space-sm border-t border-outline-variant/30 bg-surface-container-lowest space-y-space-sm">
    <form action="/logout" method="POST" class="m-0 p-0 block w-full">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="flex items-center justify-between w-full px-space-sm py-2 text-on-surface-variant hover:text-error hover:bg-surface-container-high transition-colors border-0 bg-transparent cursor-pointer text-left font-inherit">
        <div class="flex items-center gap-space-sm">
          <span class="material-symbols-outlined text-[18px]">logout</span>
          <span class="font-label-lg text-label-lg">Sign Out</span>
        </div>
        <span class="font-label-sm text-label-sm text-outline">END-SES</span>
      </button>
    </form>
  </div>
</aside>
<!-- MAIN WRAPPER -->
<div class="lg:pl-72 flex flex-col min-h-screen overflow-x-hidden">
<!-- HEADER -->
<header class="fixed top-0 left-0 right-0 lg:left-72 h-16 bg-surface-container-lowest/90 backdrop-blur-md border-b border-outline-variant/30 z-40 px-space-md lg:px-space-lg flex items-center justify-between">
  <div class="flex items-center gap-space-sm flex-1 max-w-xl">
    <button aria-label="Open sidebar menu" class="p-space-xs text-outline hover:text-on-surface lg:hidden cursor-pointer flex items-center justify-center" onclick="toggleMobileMenu()" type="button">
      <span class="material-symbols-outlined text-[24px]">menu</span>
    </button>
  </div>
  <div class="flex items-center gap-space-xs sm:gap-space-md">
    <button id="theme-toggle" data-theme-toggle type="button" aria-label="Switch to light theme" title="Switch to light theme" class="w-9 h-9 flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors border border-outline-variant/40 cursor-pointer">
      <span id="theme-toggle-icon" data-theme-icon class="material-symbols-outlined text-[20px]">light_mode</span>
    </button>
    <div class="h-6 w-px bg-outline-variant/40 hidden sm:block"></div>
    <div class="px-2.5 py-1 bg-surface-container-high border border-outline-variant/60 hidden sm:block">
      <span class="font-label-sm text-label-sm text-primary tracking-widest uppercase">ROLE: <%= user.role %></span>
    </div>
    <div class="flex items-center gap-space-sm pl-space-xs">
      <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </div>
      <div class="hidden xl:flex flex-col text-left">
        <span class="font-label-lg text-label-lg text-on-surface font-semibold leading-tight"><%= user.fullName %></span>
        <span class="font-label-sm text-label-sm text-on-surface-variant leading-tight"><%= isOwner ? 'System Owner' : 'Project Manager' %></span>
      </div>
    </div>
  </div>
</header>
<main class="w-full pt-16 bg-surface min-h-screen">
