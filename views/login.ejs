    }
  </script>
<!-- END: External Styles and Fonts -->
<!-- BEGIN: Custom CSS -->
<style data-purpose="custom-styling">
    /* Subtle custom backdrop blurs and glowing accents */
    .glass-card {
      background: rgba(15, 23, 42, 0.72);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .glow-cyan {
      box-shadow: 0 0 25px -4px rgba(56, 189, 248, 0.25);
    }

    .grid-pattern {
      background-image: radial-gradient(rgba(59, 130, 246, 0.15) 1px, transparent 1px);
      background-size: 24px 24px;
    }
  </style>
<!-- END: Custom CSS -->
</head>
<body class="bg-[#F8FAFC] text-slate-900 font-sans antialiased select-none selection:bg-brand-500 selection:text-white">
<!-- BEGIN: SplitScreenWrapper -->
<div class="min-h-screen flex flex-col lg:flex-row w-full overflow-y-auto lg:overflow-hidden">
<!-- BEGIN: LeftHeroPanel (Desktop: 48%, Deep Corporate Navy & High-Tech Aesthetic) -->
