<div class="absolute bottom-10 right-0 w-80 h-80 bg-cyan-600/15 rounded-full blur-3xl pointer-events-none"></div>
<!-- Top Branding Section -->
<div class="relative z-10">
<!-- Logo and System Badge Row -->
<div class="flex items-center justify-between gap-4 mb-8">
<div class="flex items-center space-x-3">
<img alt="Sign Board Lanka ERP Logo" class="h-11 w-auto object-contain brightness-110 drop-shadow-md" src="https://lh3.googleusercontent.com/aida/ALJJyrD7R4mBhhwdPvx-p70Pi0DiPESrweItDYiWnE9JU5n-Q_J8bXGIzK1PDQxBnrK94_I7xr-PVwz6XFPNBXqSFzQPQOviWTBrGNjGacfbKcNdrEaS7-mHrfgc2NqhTxpjT77E3nXIp0Xk9znUl9SoPQuGxZCUhWyThvfLPNLXjKhLWYd-K2Z_gZQfr_u-ai30zFlHWlItSdX_25ZyrDmJMfaSjKh5G1cbaIxszzlJVScHug">
</div>

</div>
<!-- Headline & Statement -->
<div class="space-y-3 mt-4">
<h1 class="text-2xl xl:text-3xl font-extrabold tracking-tight text-white leading-snug">
            Architectural Signage, Billboard &amp; Precision Fabrication Management
          </h1>
<p class="text-sm xl:text-base text-slate-300 font-normal leading-relaxed">Centralized ERP management for production scheduling, material inventory, client orders, and field operations across Sri Lanka.</p>
</div>
</div>
<!-- Center Showcase Image & Realtime Factory Metric Overlay -->
<div class="relative z-10 my-6 xl:my-8 group">
<div class="relative rounded-2xl overflow-hidden border border-slate-700/70 shadow-2xl glow-cyan bg-slate-900">
<img alt="A modern high-tech architectural neon signage and commercial billboard fabrication factory showroom" class="w-full h-56 xl:h-64 object-cover object-center transform transition duration-700 group-hover:scale-105" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDyv1LAQ2xA51kml5w1NN7eWffdcZlsMJIQEbBwnyiWGM64OVtBbXrmGBIGxwtTQnhZ5Q3zbBdH1vg1u0lQIo_M3KMwIsMTET374KdT4Aq8jfVSLaYPQ7ADsd5bAgGUEbe10TM7_dpRhk4JN1-VafZer2zBt_ONM1GqP4ocvCloxnWxKO79RwkFo8Ema_LG7Sqp7tqIwCLc0UiPcSejWktO2eSzBn7idEaAP0zGzc9f">
<div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
<!-- Live Telemetry Badges Floating Bar -->

</div>
</div>
<!-- Security & Encryption Badge at Bottom of Left Panel -->
<div class="relative z-10 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400"><div class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg><span class="font-medium">Sign Board Lanka ERP • Internal Business Portal</span></div><span class="text-slate-500 font-medium">Authorized Personnel Only</span></div>
</aside>
<!-- END: LeftHeroPanel -->
<!-- BEGIN: RightLoginPanel (Desktop: 52%, Clean Modern High-Contrast Light Workspace) -->
<main class="flex-1 flex flex-col justify-between bg-slate-50 lg:bg-[#F8FAFC] p-6 sm:p-10 lg:p-12 xl:p-16" data-purpose="login-main-section">
<!-- Mobile Top Bar (Displays on mobile screens < 1024px) -->
<header class="lg:hidden flex items-center justify-between pb-6 mb-4 border-b border-slate-200">
<div class="flex items-center space-x-2">
<img alt="Sign Board Lanka Logo" class="h-9 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/ALJJyrD7R4mBhhwdPvx-p70Pi0DiPESrweItDYiWnE9JU5n-Q_J8bXGIzK1PDQxBnrK94_I7xr-PVwz6XFPNBXqSFzQPQOviWTBrGNjGacfbKcNdrEaS7-mHrfgc2NqhTxpjT77E3nXIp0Xk9znUl9SoPQuGxZCUhWyThvfLPNLXjKhLWYd-K2Z_gZQfr_u-ai30zFlHWlItSdX_25ZyrDmJMfaSjKh5G1cbaIxszzlJVScHug">
</div>

</header>
<!-- Centralized Form Box Container -->
<div class="my-auto w-full max-w-md mx-auto">
<!-- Login Card Surface -->
<div class="bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200/90 p-7 sm:p-9 relative">
<!-- Card Header -->
<div class="mb-7">
<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200/80 mb-3 text-xs font-semibold text-slate-700"><span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span> ERP SYSTEM LOGIN</div>
<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
              Welcome Back
            </h2>
<p class="text-sm text-slate-500 mt-1">Sign in to manage customers, projects, designs, budgets, quotations, payments and installations.</p>
</div>
<!-- Enterprise Authentication Form -->
<form action="/login" class="space-y-5" data-purpose="authentication-form" id="erp-login-form" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if (loginError) { %>
<p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"><%= loginError %></p>
<% } %>
<!-- Email Address Field -->
<div data-purpose="input-group-identity">
<label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" for="email">Email Address <span class="text-red-500">*</span></label>
<div class="relative rounded-lg shadow-sm">
<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
<!-- User Avatar Icon -->
<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
</svg>
</div>
<input autocomplete="email" class="block w-full pl-11 pr-4 py-2.5 sm:py-3 text-sm rounded-lg border-slate-300 bg-slate-50/50 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-brand-600 focus:ring-2 focus:ring-brand-600 focus:outline-none transition duration-150 ease-in-out" id="email" name="email" placeholder="Email Address" required type="email">
</div>
</div>
<!-- Password Field with Show/Hide Toggle -->
<div data-purpose="input-group-password">
<label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" for="employee-password">
                Password <span class="text-red-500">*</span>
</label>
<div class="relative rounded-lg shadow-sm">
<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
<!-- Padlock Icon -->
<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
</svg>
</div>
<input autocomplete="current-password" class="block w-full pl-11 pr-11 py-2.5 sm:py-3 text-sm rounded-lg border-slate-300 bg-slate-50/50 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-brand-600 focus:ring-2 focus:ring-brand-600 focus:outline-none transition duration-150 ease-in-out" id="employee-password" name="password" placeholder="••••••••••••" required type="password">
<!-- Interactive Show/Hide Toggle Button -->
<button aria-label="Toggle password visibility" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-700 focus:outline-none focus:text-brand-600 cursor-pointer" id="toggle-password-visibility" type="button">
<!-- Eye Open Icon (Visible by default) -->
<svg class="h-5 w-5" fill="none" id="eye-icon-open" stroke="currentColor" viewBox="0 0 24 24">
<path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
<path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
</svg>
<!-- Eye Off Icon (Hidden by default) -->
<svg class="h-5 w-5 hidden" fill="none" id="eye-icon-closed" stroke="currentColor" viewBox="0 0 24 24">
<path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
</svg>
</button>
</div>
</div>
<!-- Primary Sign In Button -->
<button class="w-full flex items-center justify-center gap-2.5 py-3 px-4 rounded-lg text-sm font-bold text-white bg-brand-700 hover:bg-brand-800 active:bg-brand-900 shadow-md shadow-brand-700/25 hover:shadow-lg hover:shadow-brand-700/35 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-700 cursor-pointer group" data-purpose="sign-in-submit-btn" type="submit">
<span>Sign In to ERP Console</span>
<svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
</svg>
</button>
</form>
<!-- System Security Notice Banner -->

</div>
<!-- End Card Surface -->
<!-- Helpdesk Support Link below card -->

</div>
<!-- END: Centralized Form Box Container -->
<!-- Footer at Bottom of Right Panel -->
<footer class="pt-6 border-t border-slate-200/80 text-center text-xs text-slate-600 flex flex-col sm:flex-row items-center justify-between gap-2" data-purpose="page-footer"><p class="w-full text-center">Sign Board Lanka ERP • © 2025 Sign Board Lanka (Pvt) Ltd. All rights reserved.</p></footer>
</main>
<!-- END: RightLoginPanel -->
</div>
<!-- END: SplitScreenWrapper -->
<!-- BEGIN: Interactive Password Visibility Script -->
<script data-purpose="password-toggle-handler">
    document.addEventListener('DOMContentLoaded', function() {
      const toggleButton = document.getElementById('toggle-password-visibility');
      const passwordInput = document.getElementById('employee-password');
      const eyeOpen = document.getElementById('eye-icon-open');
      const eyeClosed = document.getElementById('eye-icon-closed');

      if (toggleButton && passwordInput) {
        toggleButton.addEventListener('click', function() {
          const isPassword = passwordInput.getAttribute('type') === 'password';

          if (isPassword) {
            passwordInput.setAttribute('type', 'text');
            eyeOpen.classList.add('hidden');
            eyeClosed.classList.remove('hidden');
          } else {
            passwordInput.setAttribute('type', 'password');
            eyeOpen.classList.remove('hidden');
            eyeClosed.classList.add('hidden');
          }
        });
      }
    });
  </script>
<!-- END: Interactive Password Visibility Script -->




</body></html>