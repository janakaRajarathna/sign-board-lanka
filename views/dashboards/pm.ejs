    <% }); %>
  <% } %>
</select></div><div class="space-y-2 pt-1"><span class="font-label-sm text-label-sm uppercase text-on-surface-variant block">Inspection Checklist Items (Select applicable)</span><label class="flex items-center gap-2.5 p-2 bg-surface-container cursor-pointer hover:bg-surface-container-high transition-colors"><input class="w-4 h-4 text-primary bg-surface-container-highest border-outline-variant focus:ring-primary" type="checkbox"><span class="text-on-surface text-body-sm">Signboard dimensions and layout verified against approved design</span></label><label class="flex items-center gap-2.5 p-2 bg-surface-container cursor-pointer hover:bg-surface-container-high transition-colors"><input class="w-4 h-4 text-primary bg-surface-container-highest border-outline-variant focus:ring-primary" type="checkbox"><span class="text-on-surface text-body-sm">Illumination and electrical wiring operational check</span></label><label class="flex items-center gap-2.5 p-2 bg-surface-container cursor-pointer hover:bg-surface-container-high transition-colors"><input class="w-4 h-4 text-primary bg-surface-container-highest border-outline-variant focus:ring-primary" type="checkbox"><span class="text-on-surface text-body-sm">Surface finish, paint coats, and weather seal integrity</span></label></div><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant flex items-center justify-between"><span>Inspection Result <span class="text-error">*</span></span><span id="qc-validation-warning" class="hidden text-error font-body-sm text-[11px] font-medium">Please select PASS or FAIL</span></label><div class="grid grid-cols-2 gap-2"><label class="flex items-center gap-2 p-2 bg-surface-container border border-outline-variant/40 cursor-pointer hover:border-primary"><input class="text-primary bg-surface-container-highest focus:ring-primary" name="qc_result" type="radio" value="PASS" onchange="document.getElementById('qc-validation-warning').classList.add('hidden')"><span class="text-on-surface font-semibold text-body-sm">PASS</span></label><label class="flex items-center gap-2 p-2 bg-surface-container border border-outline-variant/40 cursor-pointer hover:border-error"><input class="text-error bg-surface-container-highest focus:ring-error" name="qc_result" type="radio" value="FAIL" onchange="document.getElementById('qc-validation-warning').classList.add('hidden')"><span class="text-on-surface font-semibold text-body-sm">FAIL</span></label></div></div><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant">Inspection Findings &amp; Notes</label><textarea class="w-full p-2.5 bg-surface-container text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary text-body-sm" placeholder="Enter findings, defect remarks, or clearance observations..." rows="3"></textarea></div><div class="flex items-center justify-end gap-2 pt-3 border-t border-surface-container-high"><button class="px-4 py-2 bg-surface-container text-on-surface hover:bg-surface-container-high font-headline-sm text-label-sm uppercase" onclick="closeModal('qc-modal')" type="button">Cancel</button><button class="px-4 py-2 bg-primary-container text-on-primary-container hover:bg-secondary-container transition-colors font-headline-sm text-label-sm uppercase font-semibold" type="submit">Record Quality Check</button></div></form>
</div>
</div>
<!-- MODAL C: UPLOAD DESIGN REVISION -->
<div class="fixed inset-0 bg-surface-container-lowest/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4" id="design-rev-modal">
<div class="bg-surface-container-low max-w-lg w-full p-space-lg space-y-4 shadow-xl">
<div class="flex items-center justify-between pb-2 border-b border-surface-container-high">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-[22px]">upload_file</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-wider font-semibold">
  Upload Design Revision
</h3>
</div>
<button class="text-on-surface-variant hover:text-on-surface" onclick="closeModal('design-rev-modal')">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
<form class="space-y-3 font-body-md text-body-sm" onsubmit="handleDemoSubmit(event, 'Design Revision Submitted.')"><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant">Project Reference</label><select class="w-full h-10 px-3 bg-surface-container text-on-surface focus:outline-none focus:ring-1 focus:ring-primary font-code-tabular" required="">
  <% if (projects.length === 0) { %>
    <option value="">No active projects assigned</option>
  <% } else { %>
    <% projects.forEach(function(p) { %>
      <option value="<%= p.projectCode %>"><%= p.projectCode %> | <%= p.projectName %></option>
    <% }); %>
  <% } %>
</select></div><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant">Design File (.PDF, .AI, Images)</label><label for="design-file-input" class="block p-4 bg-surface-container border border-dashed border-outline-variant text-center space-y-1 cursor-pointer hover:bg-surface-container-high transition-colors"><span class="material-symbols-outlined text-[28px] text-primary">cloud_upload</span><span class="font-headline-sm text-body-sm text-on-surface block font-medium">Choose design file or click to browse</span><span class="font-code-tabular text-[11px] text-outline block">Supported formats: PDF, PNG, JPG, JPEG, AI</span><div id="design-filename-display" class="hidden mt-2 p-2 bg-surface-container-high border border-primary/40 font-code-tabular text-label-sm text-primary flex items-center justify-center gap-1.5"><span class="material-symbols-outlined text-[16px]">attach_file</span><span id="selected-file-label">No file chosen</span></div></label><input type="file" id="design-file-input" accept=".pdf,.png,.jpg,.jpeg,.ai" class="hidden" onchange="handleDesignFileChange(event)"></div><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant">Design Review Notes</label><textarea class="w-full p-2.5 bg-surface-container text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary text-body-sm" placeholder="Provide design review notes, revision comments, or client change requests..." rows="3"></textarea></div><div class="flex items-center justify-end gap-2 pt-3 border-t border-surface-container-high"><button class="px-4 py-2 bg-surface-container text-on-surface hover:bg-surface-container-high font-headline-sm text-label-sm uppercase" onclick="closeModal('design-rev-modal')" type="button">Cancel</button><button class="px-4 py-2 bg-primary-container text-on-primary-container hover:bg-secondary-container transition-colors font-headline-sm text-label-sm uppercase font-semibold" type="submit">Submit Design Revision</button></div></form>
</div>
</div>
<!-- TOAST NOTIFICATION CONTAINER -->
<div class="fixed bottom-6 right-6 bg-surface-container-highest text-on-surface px-4 py-3 shadow-2xl z-50 transform translate-y-24 opacity-0 transition-all duration-300 flex items-center gap-3 border-l-4 border-primary" id="demo-toast">
<span class="material-symbols-outlined text-primary text-[20px]">info</span>
<span class="font-body-md text-body-sm font-medium" id="demo-toast-msg">Notification message</span>
</div><script>function handleDesignFileChange(e){const f=e.target.files[0];const disp=document.getElementById('design-filename-display');const lbl=document.getElementById('selected-file-label');if(f&&disp&&lbl){const sz=(f.size/1024).toFixed(1)+' KB';lbl.textContent=f.name+' ('+sz+')';disp.classList.remove('hidden');}}function handleQCSubmit(e){e.preventDefault();const form=e.target;const sel=form.querySelector('input[name="qc_result"]:checked');const warn=document.getElementById('qc-validation-warning');if(!sel){if(warn)warn.classList.remove('hidden');return false;}closeModal('qc-modal');showToast('Quality Check Recorded successfully as ['+sel.value+'].');}</script>
<!-- SCRIPT FOR CLIENT INTERACTIVITY -->
<script>
    function toggleMobileMenu() {
      const sidebar = document.getElementById('sidebarDrawer');
      const backdrop = document.getElementById('mobileDrawerBackdrop');
      if (!sidebar || !backdrop) return;
      const isClosed = sidebar.classList.contains('-translate-x-full');
      if (isClosed) {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
      } else {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
      }
    }

    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    }

    function showToast(message) {
      const toast = document.getElementById('demo-toast');
      const msgEl = document.getElementById('demo-toast-msg');
      if (toast && msgEl) {
        msgEl.textContent = message;
        toast.classList.remove('translate-y-24', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-24', 'opacity-0');
        }, 3500);
      }
    }

    function triggerDemoAction(actionName) {
      showToast('Action: [' + actionName + '] triggered.');
    }

    function handleDemoSubmit(e, message) {
      e.preventDefault();
      const modal = e.target.closest('.fixed');
      if (modal) modal.classList.add('hidden');
      showToast(message);
    }

    function applyFilters() {
      const stageVal = document.getElementById('stageFilter') ? document.getElementById('stageFilter').value : 'ALL';
      const searchVal = document.getElementById('projectSearch') ? document.getElementById('projectSearch').value.toLowerCase().trim() : '';
      const rows = document.querySelectorAll('.project-row');

      rows.forEach(row => {
        const rowStage = row.dataset.stage || '';
        const rowSearch = row.dataset.search || '';

        const stageMatches = (stageVal === 'ALL' || rowStage === stageVal);
        const searchMatches = (!searchVal || rowSearch.includes(searchVal));

        if (stageMatches && searchMatches) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    // Close on Escape
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        document.querySelectorAll('.fixed:not(.hidden)').forEach(modal => {
          if (modal.id !== 'demo-toast') modal.classList.add('hidden');
        });
      }
    });
</script>
</div></main></div>
</body></html>
