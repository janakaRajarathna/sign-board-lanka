<!-- 1. WELCOME & OPERATIONAL CONTEXT BANNER -->
<section class="w-full bg-surface-container-low px-space-md py-space-lg lg:px-margin-desktop lg:py-space-xl">
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-md">
<div class="space-y-space-xs max-w-4xl">
<div class="flex flex-wrap items-center gap-2">
<span class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-primary-container text-on-primary-container font-label-sm text-label-sm uppercase tracking-widest font-semibold">
<span class="w-1.5 h-1.5 bg-primary"></span>
  Project Manager Console
</span>
<span class="inline-flex items-center px-2 py-0.5 bg-surface-container-high text-on-surface-variant font-code-tabular text-label-sm uppercase tracking-wider">
