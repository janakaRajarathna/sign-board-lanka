  function formatDate(val) {
    if (!val) return '—';
    try {
      const dt = new Date(val);
      if (isNaN(dt.getTime())) return String(val);
      return dt.toISOString().split('T')[0];
    } catch {
      return String(val);
    }
  }

  const STAGE_STYLES = {
    1: { dot: 'bg-outline', bar: 'bg-outline', badge: 'bg-surface-container-high text-on-surface' },
    2: { dot: 'bg-secondary', bar: 'bg-secondary', badge: 'bg-primary-container text-on-primary-container font-bold' },
