<!-- TOAST NOTIFICATION CONTAINER -->
<div class="fixed bottom-6 right-6 bg-surface-container-highest text-on-surface px-4 py-3 shadow-2xl z-50 transform translate-y-24 opacity-0 transition-all duration-300 flex items-center gap-3 border-l-4 border-primary" id="demo-toast">
<span class="material-symbols-outlined text-primary text-[20px]">info</span>
<span class="font-body-md text-body-sm font-medium" id="demo-toast-msg">Notification message</span>
</div><script>function handleDesignFileChange(e){const f=e.target.files[0];const disp=document.getElementById('design-filename-display');const lbl=document.getElementById('selected-file-label');if(f&&disp&&lbl){const sz=(f.size/1024).toFixed(1)+' KB';lbl.textContent=f.name+' ('+sz+')';disp.classList.remove('hidden');}}function handleQCSubmit(e){e.preventDefault();const form=e.target;const sel=form.querySelector('input[name="qc_result"]:checked');const warn=document.getElementById('qc-validation-warning');if(!sel){if(warn)warn.classList.remove('hidden');return false;}closeModal('qc-modal');showToast('Quality Check Recorded successfully as ['+sel.value+'] (Demo Preview).');}</script>
<!-- SCRIPT FOR CLIENT INTERACTIVITY -->
<script>
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    }

    function showToast(message) {
      const toast = document.getElementById('demo-toast');
      const msgEl = document.getElementById('demo-toast-msg');
      if (toast && msgEl) {
        msgEl.textContent = message;
        toast.classList.remove('translate-y-24', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-24', 'opacity-0');
        }, 3500);
      }
    }

    function triggerDemoAction(actionName) {
      showToast('Action: [' + actionName + '] triggered in PM console demo environment.');
    }

    function handleDemoSubmit(e, message) {
      e.preventDefault();
      const modal = e.target.closest('.fixed');
      if (modal) modal.classList.add('hidden');
      showToast(message);
    }

    function applyFilters() {
      const stageVal = document.getElementById('stageFilter') ? document.getElementById('stageFilter').value : 'ALL';
      const searchVal = document.getElementById('projectSearch') ? document.getElementById('projectSearch').value.toLowerCase().trim() : '';
      const rows = document.querySelectorAll('.project-row');

      rows.forEach(row => {
        const rowStage = row.dataset.stage || '';
        const rowSearch = row.dataset.search || '';

        const stageMatches = (stageVal === 'ALL' || rowStage === stageVal);
        const searchMatches = (!searchVal || rowSearch.includes(searchVal));

        if (stageMatches && searchMatches) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    // Close on Escape
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        document.querySelectorAll('.fixed:not(.hidden)').forEach(modal => {
          if (modal.id !== 'demo-toast') modal.classList.add('hidden');
        });
      }
    });
  </script>
</div></main></div>

</body></html>