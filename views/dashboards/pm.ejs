</span>
</div>
<!-- 8 Stage Visual Grid -->
<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-2">
<% stages.forEach(function(stage) {
     const count = Number(stage.projectCount) || 0;
     const pct = myActive > 0 ? Math.round((count / myActive) * 100) : 0;
     const style = STAGE_STYLES[stage.stageOrder] || { dot: 'bg-primary', bar: 'bg-primary', badge: 'bg-surface-container-high text-on-surface' };
%>
<div class="bg-surface-container p-2.5 flex flex-col justify-between space-y-2">
<div class="flex items-center justify-between">
<span class="font-code-tabular text-label-sm text-on-surface-variant font-bold">STG 0<%= stage.stageOrder %></span>
<span class="px-1.5 py-0.2 font-code-tabular text-label-sm <%= style.badge %>"><%= count %></span>
</div>
<div>
<span class="font-headline-sm text-label-sm text-on-surface block leading-tight font-medium"><%= stage.stageName %></span>
<span class="font-code-tabular text-[10px] text-on-surface-variant"><%= pct %>% of portfolio</span>
</div>
<div class="w-full bg-surface-container-highest h-1 overflow-hidden">
<div class="<%= style.bar %> h-full" style="width: <%= pct %>%;"></div>
</div>
</div>
<% }); %>
</div>
<!-- Business Rule Banner -->
<div class="p-3 bg-surface-container flex items-start gap-3">
<span class="material-symbols-outlined text-secondary text-[20px] shrink-0 mt-0.5">policy</span>
<div class="text-body-sm font-body-sm space-y-1.5 w-full">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold block">
  PM OPERATIONAL SCOPE &amp; AUTHORIZATION BOUNDARIES
</span>
<div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-on-surface-variant leading-relaxed text-body-sm">
<div>
  • <strong class="text-on-surface">Project Manager:</strong> Manages assigned projects, site visits, requirements, design versions, quality checks, and installation records.<br>
  • <strong class="text-on-surface">Commercial Boundaries:</strong> Project Manager can view relevant budget and quotation information but cannot approve budgets or manage invoices/payments.
</div>
<div>
  • <strong class="text-on-surface">Owner:</strong> Approves budgets and can perform manual project stage overrides with a mandatory reason. Only Owner can cancel or reactivate projects, with a mandatory reason and history record.<br>
  • <strong class="text-on-surface">Accounts &amp; Completion Rule:</strong> Accounts manages quotations, invoices, and payments. Project completion is only allowed after at least one installation is marked completed and the full invoice amount has been paid (Stage 8 alone does not automatically complete a project). PM cannot cancel/reactivate projects or perform Owner-only stage overrides.
</div>
</div>
</div>
</div>
</div>
</section>
<!-- 4. MAIN SPLIT: PENDING OPERATIONAL TASKS (LEFT 70%) & RECENT QUALITY CHECKS (RIGHT 30%) -->
<section class="w-full px-space-md py-space-md lg:px-margin-desktop">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
<!-- LEFT COLUMN (8 of 12 cols): ACTION QUEUE -->
<div class="lg:col-span-8 space-y-4">
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
<div class="flex items-center gap-2">
<span class="w-2 h-2 bg-secondary"></span>
<h2 class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-wider font-semibold">
  Pending Tasks &amp; Operational Actions
</h2>
<span class="px-2 py-0.5 <%= actionItems.length > 0 ? 'bg-error-container text-on-error-container' : 'bg-surface-container text-on-surface-variant' %> font-code-tabular text-label-sm uppercase font-semibold">
  <%= actionItems.length %> Action <%= actionItems.length === 1 ? 'Item' : 'Items' %>
</span>
</div>
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Filtered by: Assigned PM Projects</span>
</div>
<!-- Action Items Queue -->
<div class="space-y-3">
<% if (actionItems.length === 0) { %>
<div class="bg-surface-container-low p-space-md text-center py-8">
  <span class="material-symbols-outlined text-outline text-[32px] mb-2 block">task_alt</span>
  <p class="font-headline-sm text-body-md text-on-surface font-semibold">No Pending Action Items</p>
  <p class="font-body-sm text-on-surface-variant mt-1">All active assigned projects are progressing smoothly with no pending stage blockers.</p>
</div>
<% } else { %>
  <% actionItems.forEach(function(item) {
       const cfg = ACTION_TYPE_CONFIG[item.type] || {
         icon: 'assignment',
         label: 'Action Required',
         badgeClass: 'bg-surface-container-high text-on-surface',
         btnText: 'View Project',
         modalId: null
       };
  %>
  <div class="bg-surface-container-low p-space-md space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary text-[18px]"><%= cfg.icon %></span>
        <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold"><%= cfg.label %></span>
      </div>
      <span class="font-code-tabular text-label-sm text-on-surface-variant"><%= item.stageName %></span>
    </div>
    <div class="bg-surface-container p-3 flex flex-col md:flex-row md:items-center justify-between gap-3">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="px-1.5 py-0.5 bg-surface-container-highest font-code-tabular text-label-sm text-on-surface"><%= item.projectCode %></span>
          <span class="font-label-md text-label-md text-on-surface font-semibold"><%= item.projectName %></span>
          <span class="px-1.5 py-0.2 <%= cfg.badgeClass %> font-code-tabular text-[10px] uppercase font-bold"><%= item.type %></span>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant">
          <%= item.description %>
        </p>
      </div>
      <div class="shrink-0 flex items-center gap-2">
        <% if (cfg.modalId) { %>
          <button class="px-3 py-1.5 bg-primary-container text-on-primary-container hover:bg-secondary-container transition-colors font-headline-sm text-label-sm uppercase font-semibold" onclick="openModal('<%= cfg.modalId %>')">
            <%= cfg.btnText %>
          </button>
        <% } else { %>
          <button class="px-3 py-1.5 bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors font-headline-sm text-label-sm uppercase font-semibold" onclick="triggerDemoAction('<%= cfg.btnText %> for <%= item.projectCode %>')">
            <%= cfg.btnText %>
          </button>
        <% } %>
      </div>
    </div>
  </div>
  <% }); %>
<% } %>
</div>
</div>
<!-- RIGHT COLUMN (4 of 12 cols): RECENT QUALITY CHECKS -->
<div class="lg:col-span-4 space-y-4">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="w-2 h-2 bg-primary"></span>
<h2 class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-wider font-semibold">
  Recent Quality Checks
</h2>
</div>
<span class="px-1.5 py-0.5 bg-surface-container-high text-secondary font-code-tabular text-[11px] uppercase">Inspection Log</span>
</div>
<div class="bg-surface-container-low p-space-md space-y-4">
<% if (qualityChecks.length === 0) { %>
<div class="text-center py-8 text-on-surface-variant font-body-sm">
  <span class="material-symbols-outlined text-outline text-[32px] mb-2 block">fact_check</span>
  <p class="font-headline-sm text-body-md text-on-surface font-semibold">No Inspections Recorded</p>
  <p class="font-body-sm text-on-surface-variant mt-1">No quality check records logged yet for assigned projects.</p>
</div>
<% } else { %>
<div class="space-y-4">
  <% qualityChecks.forEach(function(qc) {
       const isPass = qc.result === 'PASS';
  %>
  <div class="flex gap-3 items-start border-b border-surface-container-high/40 pb-3 last:border-b-0 last:pb-0">
    <div class="w-7 h-7 <%= isPass ? 'bg-emerald-950/60 text-emerald-400' : 'bg-error-container/40 text-error' %> flex items-center justify-center shrink-0 mt-0.5 border <%= isPass ? 'border-emerald-500/30' : 'border-error/30' %>">
      <span class="material-symbols-outlined text-[16px]"><%= isPass ? 'check_circle' : 'cancel' %></span>
    </div>
    <div class="space-y-0.5 flex-1 min-w-0">
      <div class="flex items-center justify-between gap-1">
        <span class="font-label-md text-label-md text-on-surface font-semibold truncate"><%= qc.projectName %></span>
        <span class="px-1.5 py-0.2 <%= isPass ? 'bg-emerald-950/80 text-emerald-400 border border-emerald-500/30' : 'bg-error-container text-on-error-container border border-error/30' %> font-code-tabular text-[10px] font-bold shrink-0"><%= qc.result %></span>
      </div>
      <p class="font-body-sm text-body-sm text-on-surface-variant leading-snug">
        <span class="text-primary font-code-tabular font-semibold"><%= qc.projectCode %></span> <%= qc.remarks || 'Standard stage quality inspection verification.' %>
      </p>
      <div class="flex items-center justify-between pt-1 font-code-tabular text-[10px] text-outline">
        <span>Inspector: <%= qc.inspectorName %></span>
        <span><%= formatDate(qc.checkDate) %></span>
      </div>
    </div>
  </div>
  <% }); %>
</div>
<% } %>
</div>
</div>
</div>
</section>
<!-- 6. MY ASSIGNED PROJECTS TABLE -->
<section class="w-full px-space-md py-space-md lg:px-margin-desktop mb-space-xl">
