<div>
<div class="flex items-center gap-2">
<span class="w-2 h-2 bg-primary"></span>
<h2 class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-wider font-semibold">
  My Assigned Projects Pipeline
</h2>
<span class="px-2 py-0.5 bg-surface-container-high text-primary font-code-tabular text-label-sm uppercase">PM Scope (<%= myActive %> Projects)</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
  Distribution of <%= myActive %> assigned active projects across standard business gates
</p>
</div>
<span class="font-code-tabular text-label-sm text-on-surface-variant uppercase tracking-widest self-start sm:self-auto">
