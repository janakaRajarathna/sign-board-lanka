  const ACTION_TYPE_CONFIG = {
    SITE_VISIT: {
      icon: 'pin_drop',
      label: 'Site Visit Required',
      badgeClass: 'bg-primary-container text-on-primary-container',
      btnText: 'Schedule Visit',
