<form class="space-y-3 font-body-md text-body-sm" onsubmit="handleDemoSubmit(event, 'Design Revision Submitted (Demo Preview).')"><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant">Project Reference</label><select class="w-full h-10 px-3 bg-surface-container text-on-surface focus:outline-none focus:ring-1 focus:ring-primary font-code-tabular" required=""><option value="PRJ-2026-095">PRJ-2026-095 | HNB Towers External Backlit Sign</option><option value="PRJ-2026-089">PRJ-2026-089 | Dialog Axiata Acrylic Pylon</option><option value="PRJ-2026-102">PRJ-2026-102 | Cargills Food City Colombo 05</option></select></div><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant">Design File (.PDF, .AI, Images)</label><label for="design-file-input" class="block p-4 bg-surface-container border border-dashed border-outline-variant text-center space-y-1 cursor-pointer hover:bg-surface-container-high transition-colors"><span class="material-symbols-outlined text-[28px] text-primary">cloud_upload</span><span class="font-headline-sm text-body-sm text-on-surface block font-medium">Choose design file or click to browse</span><span class="font-code-tabular text-[11px] text-outline block">Supported formats: PDF, PNG, JPG, JPEG, AI</span><div id="design-filename-display" class="hidden mt-2 p-2 bg-surface-container-high border border-primary/40 font-code-tabular text-label-sm text-primary flex items-center justify-center gap-1.5"><span class="material-symbols-outlined text-[16px]">attach_file</span><span id="selected-file-label">No file chosen</span></div></label><input type="file" id="design-file-input" accept=".pdf,.png,.jpg,.jpeg,.ai" class="hidden" onchange="handleDesignFileChange(event)"></div><div class="space-y-1"><label class="font-label-sm text-label-sm uppercase text-on-surface-variant">Design Review Notes</label><textarea class="w-full p-2.5 bg-surface-container text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary text-body-sm" placeholder="Provide design review notes, revision comments, or client change requests..." rows="3"></textarea></div><div class="flex items-center justify-end gap-2 pt-3 border-t border-surface-container-high"><button class="px-4 py-2 bg-surface-container text-on-surface hover:bg-surface-container-high font-headline-sm text-label-sm uppercase" onclick="closeModal('design-rev-modal')" type="button">Cancel</button><button class="px-4 py-2 bg-primary-container text-on-primary-container hover:bg-secondary-container transition-colors font-headline-sm text-label-sm uppercase font-semibold" type="submit">Submit Design Revision</button></div></form>
