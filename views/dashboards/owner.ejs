<script>
  function handleOwnerAction(actionType, targetRef) {
    const promptMessage = '[DEMO PROTOTYPE] OWNER ACTION: ' + actionType + (targetRef ? ' for ' + targetRef : '') +
      '\n\nNotice: This is a front-end preview demonstration.' +
      '\nIn production, a mandatory reason is recorded in the PostgreSQL audit log.' +
      '\n\nPlease enter a mandatory business reason to test validation:';

    const reason = prompt(promptMessage);

    if (reason && reason.trim().length > 0) {
      alert('[DEMO PROTOTYPE] Action logged locally for preview.\n\nAction: ' + actionType +
            (targetRef ? '\nTarget: ' + targetRef : '') +
            '\nReason Entered: "' + reason.trim() + '"' +
            '\n\nNote: In production, this records a mandatory audit trail in PostgreSQL. No database was updated.');
    } else if (reason !== null) {
      alert('[DEMO PROTOTYPE] Validation Failed: A mandatory reason is strictly required before this owner action can proceed.');
    }
  }

  document.getElementById('btn-stage-override')?.addEventListener('click', function() {
    handleOwnerAction('Manual Stage Override', 'Selected Demo Project');
  });

  document.getElementById('btn-project-cancellation')?.addEventListener('click', function() {
    handleOwnerAction('Project Cancellation', 'Selected Demo Project');
  });

  document.getElementById('btn-new-project')?.addEventListener('click', function() {
    alert('[DEMO PROTOTYPE] Opening New Project Intake Specification Form (Stage 1: Project Registration). No live database record will be created.');
  });

  document.getElementById('stage-filter')?.addEventListener('change', function(e) {
    console.log('[DEMO] Filtering sample table by stage: ' + e.target.value);
  });
</script></main></div>

