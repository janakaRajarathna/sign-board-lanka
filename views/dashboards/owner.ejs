<!-- MODULE UNAVAILABLE NOTICE -->
<div
  aria-live="polite"
  aria-atomic="true"
  class="hidden fixed top-20 left-1/2 -translate-x-1/2 z-50 w-full max-w-sm"
  id="sbl-unavailable-notice"
  role="status"
>
  <div class="flex items-start gap-space-sm bg-surface-container-high border border-outline-variant/60 shadow-xl px-space-md py-space-sm">
    <span class="material-symbols-outlined text-[20px] text-primary shrink-0 mt-0.5" aria-hidden="true">construction</span>
    <div class="flex flex-col flex-1 min-w-0">
      <span class="font-label-lg text-label-lg text-on-surface font-semibold" id="sbl-unavailable-module">Module</span>
      <span class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">This module is under development and not yet available.</span>
    </div>
    <button
      aria-label="Dismiss notice"
      class="shrink-0 p-space-xs text-outline hover:text-on-surface hover:bg-surface-container transition-colors cursor-pointer border-0 bg-transparent"
      id="sbl-unavailable-dismiss"
      type="button"
    >
      <span class="material-symbols-outlined text-[18px]" aria-hidden="true">close</span>
    </button>
  </div>
</div>
<script>
  function handleOwnerAction(actionType, targetRef) {
    const promptMessage = 'OWNER ACTION: ' + actionType + (targetRef ? ' for ' + targetRef : '') +
      '\n\nNotice: Every manual stage override, project cancellation, and project reactivation requires a mandatory reason and is recorded in the system audit history.' +
      '\n\nPlease enter a mandatory business reason:';

    const reason = prompt(promptMessage);

    if (reason && reason.trim().length > 0) {
      alert('Action logged.\n\nAction: ' + actionType +
            (targetRef ? '\nTarget: ' + targetRef : '') +
            '\nReason Entered: "' + reason.trim() + '"');
    } else if (reason !== null) {
      alert('Validation Failed: A mandatory reason is strictly required before this owner action can proceed.');
    }
  }

  document.getElementById('btn-stage-override')?.addEventListener('click', function() {
    handleOwnerAction('Manual Stage Override', 'Selected Project');
  });

  document.getElementById('btn-project-cancellation')?.addEventListener('click', function() {
    handleOwnerAction('Project Cancellation', 'Selected Project');
  });

  document.getElementById('btn-new-project')?.addEventListener('click', function() {
    alert('Opening New Project Intake Specification Form (Stage 1: Project Registration).');
  });

  function toggleMobileMenu() {
    const sidebar = document.getElementById('sidebarDrawer');
    const backdrop = document.getElementById('mobileDrawerBackdrop');
    if (!sidebar || !backdrop) return;
    const isClosed = sidebar.classList.contains('-translate-x-full');
    if (isClosed) {
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
    } else {
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('hidden');
    }
  }

  // ── Sidebar navigation: active-state init & unavailable-module handler ──

  (function initSidebarNav() {
    var ACTIVE_CLASSES = ['bg-primary-container', 'text-on-primary-container', 'font-semibold', 'border-l-2', 'border-primary'];
    var INACTIVE_CLASSES = ['text-on-surface-variant', 'hover:bg-surface-container', 'hover:text-on-surface'];
    var IMPLEMENTED_PATHS = { 'dashboard': '/dashboard', 'projects': '/projects' };

    var notice    = document.getElementById('sbl-unavailable-notice');
    var moduleEl  = document.getElementById('sbl-unavailable-module');
    var dismissBtn = document.getElementById('sbl-unavailable-dismiss');
    var hideTimer = null;

    function showNotice(label) {
      if (!notice || !moduleEl) return;
      if (moduleEl.textContent === label && !notice.classList.contains('hidden')) return;
      clearTimeout(hideTimer);
      moduleEl.textContent = label;
      notice.classList.remove('hidden');
      hideTimer = setTimeout(function() { notice.classList.add('hidden'); }, 6000);
    }

    function hideNotice() {
      if (!notice) return;
      clearTimeout(hideTimer);
      notice.classList.add('hidden');
    }

    if (dismissBtn) {
      dismissBtn.addEventListener('click', hideNotice);
    }

    // Active-state: mark Dashboard active when path is /dashboard
    var currentPath = window.location.pathname;
    var navLinks = document.querySelectorAll('nav[data-active-classes] a[data-path]');

    navLinks.forEach(function(link) {
      var path = link.getAttribute('data-path');
      var isActive = (path === 'dashboard' && currentPath === '/dashboard');

      if (isActive) {
        ACTIVE_CLASSES.forEach(function(c) { link.classList.add(c); });
        INACTIVE_CLASSES.forEach(function(c) { link.classList.remove(c); });
        link.setAttribute('aria-current', 'page');
      } else {
        ACTIVE_CLASSES.forEach(function(c) { link.classList.remove(c); });
        link.removeAttribute('aria-current');
      }

      // Intercept clicks on unimplemented links
      if (!IMPLEMENTED_PATHS[path]) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          var label = link.querySelector('span:not(.material-symbols-outlined)');
          showNotice(label ? label.textContent.trim() : 'This module');
        });
      }
    });
  }());
</script></main></div>
</body></html>
