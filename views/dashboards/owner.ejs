<th class="p-space-sm font-semibold">Project Name</th>
<th class="p-space-sm font-semibold">Customer</th>
<th class="p-space-sm font-semibold">Assigned Project Manager</th>
<th class="p-space-sm font-semibold">Current Stage</th>
<th class="p-space-sm font-semibold">Status</th>
<th class="p-space-sm font-semibold">Created Date</th>
<th class="p-space-sm font-semibold text-right">Actions</th>
