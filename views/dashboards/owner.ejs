          <span class="font-code-tabular text-body-sm text-outline">
            <%= act.changedAt ? new Date(act.changedAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) + ' ' + new Date(act.changedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '' %>
          </span>
        </div>
        <p class="font-body-md text-body-md text-on-surface">
          <strong><%= act.projectCode %></strong>
          <% if (act.oldStageName && act.newStageName) { %>
