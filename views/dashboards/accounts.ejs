<!-- MODAL: RECORD PAYMENT QUICK ACTION -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-space-md bg-surface-container-lowest/80 backdrop-blur-sm hidden" id="paymentModal">
<div class="bg-surface-container-low max-w-lg w-full p-space-lg flex flex-col gap-space-md shadow-2xl relative border border-outline-variant/30 max-h-[90vh] overflow-y-auto">
<!-- Modal Header -->
<div class="flex items-start justify-between">
<div class="flex flex-col gap-space-xs">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-[20px]">payments</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface uppercase">Record Client Payment</h3>
</div>
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">
            Sample Prototype Demo Simulation
          </span>
</div>
<button aria-label="Close modal" class="p-space-xs text-outline hover:text-on-surface hover:bg-surface-container transition-colors cursor-pointer" onclick="closePaymentModal()" type="button">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
<!-- Payment Form -->
<form class="flex flex-col gap-space-md" id="paymentForm" onsubmit="handlePaymentSubmit(event)">
<!-- Project Select -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="projectSelect">Target Project</label>
<select class="h-10 px-space-sm bg-surface-container text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="projectSelect" onchange="updateProjectCalculations()" required="">
<option selected="" value="PRJ-2026-081">PRJ-2026-081 | Odel Department Store Facia (INV-044 issued: LKR 1,240,000 Due)</option>
<option value="PRJ-2026-089">PRJ-2026-089 | Dialog Axiata 3D Acrylic Rooftop Pylon (Quote Accepted | 30% Advance Settled)</option>
<option value="PRJ-2026-095">PRJ-2026-095 | HNB Towers Backlit Monolith (Quotation Sent - Awaiting Acceptance)</option>
</select>
</div>
<!-- Project Status & Rules Notice Banner -->
<div class="p-space-sm bg-surface-container border-l-2 border-secondary flex flex-col gap-0.5" id="eligibilityNoticeContainer">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold" id="eligibilityNoticeTitle">Eligibility Status</span>
<p class="font-body-sm text-body-sm text-on-surface-variant" id="eligibilityNoticeText">Final invoice INV-044 issued. Eligible for Final Payment settlement up to outstanding balance.</p>
</div>
<!-- Payment Type -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Payment Allocation Type</label>
<div class="grid grid-cols-2 gap-space-sm">
<label class="flex items-center gap-space-sm p-space-sm bg-surface-container cursor-pointer hover:bg-surface-container-high">
<input class="accent-primary" id="radioAdvance" name="paymentType" onchange="updateProjectCalculations()" type="radio" value="ADVANCE"/>
<span class="font-label-md text-label-md text-on-surface">30% Advance Deposit</span>
</label>
<label class="flex items-center gap-space-sm p-space-sm bg-surface-container cursor-pointer hover:bg-surface-container-high">
<input checked="" class="accent-primary" id="radioFinal" name="paymentType" onchange="updateProjectCalculations()" type="radio" value="FINAL"/>
<span class="font-label-md text-label-md text-on-surface">Final / Balance Payment</span>
</label>
</div>
</div>
<!-- Amount and Max helper -->
<div class="flex flex-col gap-space-xs">
<div class="flex items-center justify-between">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="paymentAmount">Amount (LKR)</label>
<span class="font-label-sm text-label-sm font-code-tabular text-secondary" id="maxBalanceHint">Outstanding Balance Due: LKR 1,240,000</span>
</div>
<div class="relative flex items-center">
<span class="absolute left-space-sm font-label-md text-label-md text-outline font-code-tabular">LKR</span>
<input class="w-full h-10 pl-12 pr-space-sm bg-surface-container text-on-surface font-code-tabular text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="paymentAmount" min="1" required="" type="number" value="1240000"/>
</div>
<span class="font-label-sm text-label-sm text-error hidden p-space-xs bg-error-container/20 border-l border-error" id="validationWarning"></span>
</div>
<!-- Payment Method (EXACTLY CASH and BANK_TRANSFER only) -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="paymentMethod">Payment Method</label>
<select class="h-10 px-space-sm bg-surface-container text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="paymentMethod" required="">
<option value="BANK_TRANSFER">BANK_TRANSFER</option>
<option value="CASH">CASH</option>
</select>
</div>
<!-- Reference / Voucher Note (Optional, no fake prefill) -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="voucherNote">Payment / Voucher Reference (Optional)</label>
<input class="h-10 px-space-sm bg-surface-container text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors placeholder:text-outline/60" id="voucherNote" placeholder="e.g., SL-TRX-XXXX or leave blank" type="text" value=""/>
</div>
<!-- Payment Evidence Upload (Optional Demo Prototype) -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="evidenceUpload">Payment Evidence (Optional - Demo Prototype)</label>
<div class="flex items-center gap-space-sm">
<input class="block w-full text-body-sm text-outline file:mr-4 file:py-2 file:px-4 file:border-0 file:text-label-sm file:font-semibold file:bg-surface-container-high file:text-on-surface hover:file:bg-surface-container-highest cursor-pointer bg-surface-container" id="evidenceUpload" type="file"/>
</div>
</div>
<!-- Buttons -->
<div class="flex items-center justify-end gap-space-sm pt-space-xs">
<button class="px-space-md py-space-sm bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-md text-label-md uppercase tracking-wider transition-colors cursor-pointer" onclick="closePaymentModal()" type="button">
            Cancel
          </button>
<button class="px-space-md py-space-sm bg-primary-container hover:bg-secondary-container text-on-primary font-label-md text-label-md uppercase tracking-wider transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" id="submitPaymentBtn" type="submit">
            Confirm &amp; Post to Ledger
          </button>
</div>
</form>
</div>
</div>
<!-- TOAST NOTIFICATION CONTAINER -->
<div class="fixed bottom-space-md right-space-md px-space-md py-space-sm bg-surface-container-highest text-on-surface font-body-md text-body-md shadow-xl transition-all duration-300 transform translate-y-12 opacity-0 pointer-events-none z-50 flex items-center gap-space-sm border border-outline-variant/40" id="toastMessage">
<span class="material-symbols-outlined text-secondary text-[20px]" id="toastIcon">check_circle</span>
<span id="toastText">Transaction updated successfully.</span>
</div>
</div>
<script>
  // Project balances and ERP status state
  const demoBalances = {
    'PRJ-2026-081': {
      status: 'INVOICED',
      invoiceIssued: true,
      quotationAccepted: true,
      advanceReceived: 930000,
      maxAdvance: 930000,
      totalQuote: 3100000,
      balanceDue: 1240000,
      invoiceRef: 'INV-044'
    },
    'PRJ-2026-089': {
      status: 'QUOTE_ACCEPTED_ADVANCE_RECEIVED',
      invoiceIssued: false,
      quotationAccepted: true,
      advanceReceived: 726000,
      maxAdvance: 726000,
      totalQuote: 2420000,
      balanceDue: 1694000,
      invoiceRef: null
    },
    'PRJ-2026-095': {
      status: 'QUOTATION_SENT',
      invoiceIssued: false,
      quotationAccepted: false,
      advanceReceived: 0,
      maxAdvance: 555000,
      totalQuote: 1850000,
      balanceDue: 1850000,
      invoiceRef: null
    }
  };

  function toggleMobileMenu() {
    const sidebar = document.getElementById('sidebarDrawer');
    const backdrop = document.getElementById('mobileDrawerBackdrop');
    if (!sidebar || !backdrop) return;
    const isClosed = sidebar.classList.contains('-translate-x-full');
    if (isClosed) {
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
    } else {
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('hidden');
    }
  }

  function openPaymentModal() {
    document.getElementById('paymentModal').classList.remove('hidden');
    updateProjectCalculations();
  }

  function openPaymentModalWithProject(projectId) {
    const sel = document.getElementById('projectSelect');
    if (sel) sel.value = projectId;
    openPaymentModal();
  }

  function closePaymentModal() {
    document.getElementById('paymentModal').classList.add('hidden');
    document.getElementById('validationWarning').classList.add('hidden');
  }

  function updateProjectCalculations() {
    const prjId = document.getElementById('projectSelect').value;
    const typeRadios = document.getElementsByName('paymentType');
    let paymentType = 'FINAL';
    for (const r of typeRadios) {
      if (r.checked) paymentType = r.value;
    }

    const prj = demoBalances[prjId];
    const hint = document.getElementById('maxBalanceHint');
    const amountInput = document.getElementById('paymentAmount');
    const warn = document.getElementById('validationWarning');
    const noticeText = document.getElementById('eligibilityNoticeText');
    const noticeContainer = document.getElementById('eligibilityNoticeContainer');
    const noticeTitle = document.getElementById('eligibilityNoticeTitle');
    const submitBtn = document.getElementById('submitPaymentBtn');

    warn.classList.add('hidden');
    submitBtn.disabled = false;
    noticeContainer.classList.remove('border-error', 'border-secondary', 'border-tertiary');

    if (!prj) return;

    if (prjId === 'PRJ-2026-095') {
      // HNB: Quotation sent, awaiting client acceptance
      noticeContainer.classList.add('border-error');
      noticeTitle.textContent = 'Action Blocked: Awaiting Acceptance';
      noticeText.textContent = 'Quotation is awaiting client acceptance. Payments cannot be recorded prior to client acceptance.';
      hint.textContent = 'Allowed Amount: LKR 0';
      amountInput.value = '0';
      amountInput.disabled = true;
      submitBtn.disabled = true;
      warn.textContent = 'Payments cannot be recorded prior to client acceptance.';
      warn.classList.remove('hidden');
      return;
    }

    if (prjId === 'PRJ-2026-089') {
      // Dialog: Accepted quote, 30% advance received, final invoice not yet issued
      amountInput.disabled = false;
      if (paymentType === 'ADVANCE') {
        noticeContainer.classList.add('border-error');
        noticeTitle.textContent = 'Advance Target Fulfilled';
        noticeText.textContent = '30% Advance already fully settled (LKR 726,000). Remaining advance eligible is LKR 0.';
        hint.textContent = 'Remaining 30% Advance: LKR 0';
        amountInput.value = '0';
        submitBtn.disabled = true;
        warn.textContent = 'Duplicate Advance restriction: 30% advance is already 100% collected.';
        warn.classList.remove('hidden');
      } else {
        // Final payment requested but invoice not issued
        noticeContainer.classList.add('border-error');
        noticeTitle.textContent = 'Invoice Not Yet Issued';
        noticeText.textContent = '30% Advance already fully settled (LKR 726,000). Final single invoice has not yet been issued; final payment cannot be recorded before invoice creation.';
        hint.textContent = 'Allowed Final Payment: LKR 0';
        amountInput.value = '0';
        submitBtn.disabled = true;
        warn.textContent = 'Final payments strictly require an issued invoice.';
        warn.classList.remove('hidden');
      }
      return;
    }

    if (prjId === 'PRJ-2026-081') {
      // Odel: Final Invoice INV-044 issued, balance LKR 1,240,000
      amountInput.disabled = false;
      if (paymentType === 'ADVANCE') {
        noticeContainer.classList.add('border-tertiary');
        noticeTitle.textContent = 'Advance Already Credited';
        noticeText.textContent = 'Advance deposit of LKR 930,000 was already settled and credited against single final invoice INV-044.';
        hint.textContent = 'Remaining 30% Advance: LKR 0';
        amountInput.value = '0';
        submitBtn.disabled = true;
        warn.textContent = 'Advance quota fully settled. Please select "Final / Balance Payment" to settle outstanding balance.';
        warn.classList.remove('hidden');
      } else {
        noticeContainer.classList.add('border-secondary');
        noticeTitle.textContent = 'Invoice INV-044 Active';
        noticeText.textContent = 'Final single invoice INV-044 is issued. Outstanding balance is LKR 1,240,000.';
        hint.textContent = 'Outstanding Invoice Balance: LKR ' + prj.balanceDue.toLocaleString();
        amountInput.value = prj.balanceDue;
        submitBtn.disabled = false;
      }
    }
  }

  function handlePaymentSubmit(e) {
    e.preventDefault();
    const prjId = document.getElementById('projectSelect').value;
    const amount = parseFloat(document.getElementById('paymentAmount').value) || 0;
    const typeRadios = document.getElementsByName('paymentType');
    let paymentType = 'FINAL';
    for (const r of typeRadios) {
      if (r.checked) paymentType = r.value;
    }

    const prj = demoBalances[prjId];
    const warn = document.getElementById('validationWarning');

    if (amount <= 0) {
      warn.textContent = 'Validation Error: Please enter a valid amount greater than LKR 0.';
      warn.classList.remove('hidden');
      return;
    }

    if (prjId === 'PRJ-2026-095') {
      warn.textContent = 'Validation Blocked: Quotation is awaiting client acceptance.';
      warn.classList.remove('hidden');
      return;
    }

    if (prjId === 'PRJ-2026-089') {
      if (paymentType === 'ADVANCE') {
        warn.textContent = 'Validation Error: 30% Advance already fully settled (LKR 726,000).';
      } else {
        warn.textContent = 'Validation Error: Final single invoice has not yet been issued; cannot record final payment.';
      }
      warn.classList.remove('hidden');
      return;
    }

    if (prjId === 'PRJ-2026-081') {
      if (paymentType === 'ADVANCE') {
        warn.textContent = 'Validation Error: 30% Advance already fully received for PRJ-2026-081.';
        warn.classList.remove('hidden');
        return;
      }
      if (amount > prj.balanceDue) {
        warn.textContent = 'Overpayment restriction: Entered amount (LKR ' + amount.toLocaleString() + ') exceeds outstanding balance of LKR ' + prj.balanceDue.toLocaleString();
        warn.classList.remove('hidden');
        return;
      }
    }

    // Success Prototype Simulation
    closePaymentModal();
    showToast('Payment of LKR ' + amount.toLocaleString() + ' recorded for ' + prjId + ' (Demo Prototype)');
  }

  function handleQuickAction(actionName, prjId, name) {
    showToast(actionName + ' opened for ' + prjId + ' (' + name + ')');
  }

  function openInvoiceNotification() {
    showToast('Redirecting to Invoice Management creation interface...');
  }

  function showToast(msg) {
    const t = document.getElementById('toastMessage');
    const txt = document.getElementById('toastText');
    txt.textContent = msg;
    t.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
    t.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      t.classList.remove('translate-y-0', 'opacity-100');
      t.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
    }, 3800);
  }
</script></main></div></body></html>