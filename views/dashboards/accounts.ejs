nt" href="#"><span class="material-symbols-outlined text-[20px]">account_balance_wallet</span><span>Budget Management</span></a><a class="flex items-center gap-space-sm px-space-sm py-space-sm rounded-none text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors font-label-lg text-label-lg" data-path="quotation-management" href="#"><span class="material-symbols-outlined text-[20px]">request_quote</span><span>Quotation Management</span></a><a class="flex items-center gap-space-sm px-space-sm py-space-sm rounded-none text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors font-label-lg text-label-lg" data-path="invoice-management" href="#"><span class="material-symbols-outlined text-[20px]">receipt_long</span><span>Invoice Management</span></a><a class="flex items-center gap-space-sm px-space-sm py-space-sm rounded-none text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors font-label-lg text-label-lg" data-path="payment-management" href="#"><span class="material-symbols-outlined text-[20px]">payments</span><span>Payment Management</span></a><a class="flex items-center gap-space-sm px-space-sm py-space-sm rounded-none text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors font-label-lg text-label-lg" data-path="financial-reports" href="#"><span class="material-symbols-outlined text-[20px]">analytics</span><span>Financial Reports</span></a></nav></div><div class="p-space-xs border-t border-outline-variant/30 bg-surface-container-lowest/40"><form action="/logout" method="POST" class="m-0 p-0 block w-full">
