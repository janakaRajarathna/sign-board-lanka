<%
  const d = data || {};
  const k = d.kpis || {};
  const tasks = Array.isArray(d.pendingFinancialTasks) ? d.pendingFinancialTasks : [];
  const payments = Array.isArray(d.recentPayments) ? d.recentPayments : [];
  const invoices = Array.isArray(d.outstandingInvoices) ? d.outstandingInvoices : [];

  function formatLKR(val) {
    const num = Number(val) || 0;
    return num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function formatDate(val) {
    if (!val) return '—';
    try {
      const dt = new Date(val);
      if (isNaN(dt.getTime())) return String(val);
      return dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    } catch {
      return String(val);
    }
  }

  function formatDateTime(val) {
    if (!val) return '—';
    try {
      const dt = new Date(val);
      if (isNaN(dt.getTime())) return String(val);
      return dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' +
        dt.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
    } catch {
      return String(val);
    }
  }

  const TASK_TYPE_STYLES = {
    BUDGET_PREP: {
      tag: 'Budget Draft Required',
      badgeClass: 'bg-surface-container-highest text-outline',
      btnClass: 'bg-surface-container-highest hover:bg-primary-container hover:text-on-primary text-on-surface'
    },
    QUOTATION_DRAFT: {
      tag: 'Quotation In Draft',
      badgeClass: 'bg-surface-container-highest text-tertiary',
      btnClass: 'bg-surface-container-highest hover:bg-primary-container hover:text-on-primary text-on-surface'
    },
    ISSUE_ADVANCE_INVOICE: {
      tag: 'Advance Invoice Required',
      badgeClass: 'bg-primary-container text-on-primary-container font-medium',
      btnClass: 'bg-surface-container-highest hover:bg-primary-container hover:text-on-primary text-on-surface'
    },
    COLLECT_ADVANCE: {
      tag: 'Advance Payment Pending',
      badgeClass: 'bg-surface-container-highest text-secondary',
      btnClass: 'bg-primary-container hover:bg-secondary-container text-on-primary'
    },
    COLLECT_FINAL: {
      tag: 'Final Payment Settlement',
      badgeClass: 'bg-surface-container-highest text-secondary',
      btnClass: 'bg-primary-container hover:bg-secondary-container text-on-primary'
    }
  };
%>
