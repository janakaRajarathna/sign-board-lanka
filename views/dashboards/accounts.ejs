= user.fullName %></span><span class="font-label-sm text-label-sm text-outline leading-tight">Role: <%= user.role %></span></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header>
<!-- MAIN CONTENT -->
<main class="relative pt-16 bg-surface min-h-screen w-full px-space-md py-space-md"><div class="flex flex-col w-full gap-space-lg">
<!-- PAGE HEADER -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-xs">
<div class="flex flex-col gap-space-xs">
<div class="flex items-center gap-space-sm flex-wrap">
<h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight uppercase">Accounts Overview</h1>
<span class="px-space-xs py-0.5 bg-surface-container-highest text-primary font-label-sm text-label-sm uppercase tracking-wider">
  Finance &amp; Ledger Console
</span>
</div>
<p class="font-body-md text-body-md text-outline">
  Financial ledger, invoices, and payment tracking for Sign Board Lanka client projects in Sri Lankan Rupees (LKR).
</p>
</div>
<!-- Actions -->
<div class="flex items-center gap-space-sm self-start md:self-auto flex-wrap">
<button class="flex items-center gap-space-xs px-space-md py-space-sm bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-lg text-label-lg transition-colors cursor-pointer" onclick="openInvoiceNotification()" type="button">
<span class="material-symbols-outlined text-[18px]">post_add</span>
<span>+ New Invoice</span>
</button>
<button class="flex items-center gap-space-xs px-space-md py-space-sm bg-primary-container hover:bg-secondary-container text-on-primary font-label-lg text-label-lg transition-colors cursor-pointer shadow-md" onclick="openPaymentModal()" type="button">
<span class="material-symbols-outlined text-[18px]">payments</span>
<span>+ Record Payment</span>
</button>
</div>
</div>
<!-- FOUR KPI CARDS (1 Col Mobile, 2 Col Tablet, 4 Col Desktop Grid) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
<!-- KPI 1 -->
<div class="bg-surface-container-low p-space-md flex flex-col justify-between gap-space-md relative overflow-hidden shadow-sm">
<div class="flex items-start justify-between gap-space-xs">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-outline">Costing Stage</span>
<span class="font-label-lg text-label-lg text-on-surface font-medium mt-1">Pending Budget Preparations</span>
</div>
<span class="px-space-xs py-0.5 bg-surface-container-highest text-secondary font-label-sm text-label-sm uppercase">
  Costing Queue
</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface"><%= Number(k.pendingBudgetPrepCount) || 0 %> Projects</span>
<span class="font-body-sm text-body-sm text-outline">Active projects awaiting initial costing in Stage 4</span>
</div>
</div>
<!-- KPI 2 -->
<div class="bg-surface-container-low p-space-md flex flex-col justify-between gap-space-md relative overflow-hidden shadow-sm">
<div class="flex items-start justify-between gap-space-xs">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-outline">Proposals</span>
<span class="font-label-lg text-label-lg text-on-surface font-medium mt-1">Pending Quotations</span>
</div>
<span class="px-space-xs py-0.5 bg-surface-container-highest text-tertiary font-label-sm text-label-sm uppercase">
  Client Review
</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface"><%= Number(k.pendingQuotationsCount) || 0 %> Quotations</span>
<span class="font-body-sm text-body-sm text-outline"><%= Number(k.quotationsDraftCount) || 0 %> in draft preparation, <%= Number(k.quotationsSentCount) || 0 %> sent to client</span>
</div>
</div>
<!-- KPI 3: Outstanding Receivables -->
<div class="bg-surface-container-low p-space-md flex flex-col justify-between gap-space-md relative overflow-hidden shadow-sm">
<div class="flex items-start justify-between gap-space-xs">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-outline">Unsettled Receivables</span>
<span class="font-label-lg text-label-lg text-on-surface font-medium mt-1">Outstanding Balance</span>
</div>
<span class="px-space-xs py-0.5 bg-surface-container-highest text-secondary font-label-sm text-label-sm uppercase">
  <%= Number(k.unpaidInvoicesCount) || 0 %> Active Invoices
</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-headline-lg text-headline-lg font-bold text-primary font-code-tabular">LKR <%= formatLKR(k.totalOutstandingBalance) %></span>
<span class="font-body-sm text-body-sm text-outline">Total unpaid balance across issued client invoices</span>
</div>
</div>
<!-- KPI 4 -->
<div class="bg-surface-container-low p-space-md flex flex-col justify-between gap-space-md relative overflow-hidden shadow-sm">
<div class="flex items-start justify-between gap-space-xs">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-outline">Ledger Realized</span>
<span class="font-label-lg text-label-lg text-on-surface font-medium mt-1">Total Payments Received</span>
</div>
<span class="px-space-xs py-0.5 bg-surface-container-highest text-on-primary-container font-label-sm text-label-sm uppercase">
  This Month
</span>
</div>
<div class="flex flex-col gap-space-xs">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface font-code-tabular">LKR <%= formatLKR(k.paymentsReceivedThisMonth) %></span>
<span class="font-body-sm text-body-sm text-outline"><%= Number(k.paymentCountThisMonth) || 0 %> payments received in current month</span>
</div>
</div>
</div>
<!-- MAIN CONTENT SPLIT (Left ~65%, Right ~35%) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md items-start">
<!-- LEFT: Pending Financial Tasks (8 cols = ~66%) -->
<div class="lg:col-span-8 flex flex-col bg-surface-container-low p-space-md gap-space-md shadow-sm">
<div class="flex items-center justify-between pb-space-xs">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-[22px]">assignment_turned_in</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight">Pending Financial Tasks</h2>
</div>
<span class="px-space-sm py-0.5 bg-surface-container-highest text-on-surface font-label-sm text-label-sm uppercase tracking-wider">
  Action Items (<%= tasks.length %>)
</span>
</div>
<!-- Task List -->
<div class="flex flex-col gap-space-sm">
<% if (tasks.length === 0) { %>
  <div class="p-space-lg bg-surface-container text-center flex flex-col items-center justify-center gap-space-xs text-outline">
    <span class="material-symbols-outlined text-[32px] text-primary/60">task_alt</span>
    <span class="font-label-lg text-on-surface">No Pending Financial Tasks</span>
    <span class="font-body-sm text-on-surface-variant">All project costing, quotations, and pending billing actions are up to date.</span>
  </div>
<% } else { %>
  <% tasks.forEach(function(item) {
       const style = TASK_TYPE_STYLES[item.taskType] || {
         tag: item.taskType || 'Financial Task',
         badgeClass: 'bg-surface-container-highest text-outline',
         btnClass: 'bg-surface-container-highest hover:bg-primary-container hover:text-on-primary text-on-surface'
       };
  %>
  <div class="p-space-md bg-surface-container flex flex-col md:flex-row md:items-center justify-between gap-space-md transition-colors hover:bg-surface-container-high">
    <div class="flex flex-col gap-space-xs max-w-xl">
      <div class="flex items-center gap-space-sm flex-wrap">
        <span class="font-label-md text-label-md font-code-tabular text-secondary font-semibold"><%= item.projectCode %></span>
        <span class="text-outline text-label-sm">/</span>
        <span class="font-label-md text-label-md text-on-surface font-semibold"><%= item.projectName %></span>
        <span class="px-space-xs py-0.5 <%= style.badgeClass %> font-label-sm text-label-sm uppercase">
          <%= style.tag %>
        </span>
      </div>
      <p class="font-body-sm text-body-sm text-on-surface-variant">
        Customer: <strong class="text-on-surface"><%= item.customerName %></strong> — <%= item.description %>
      </p>
    </div>
    <button class="px-space-md py-space-xs <%= style.btnClass %> font-label-md text-label-md uppercase tracking-wider self-start md:self-auto transition-colors whitespace-nowrap cursor-pointer" onclick="handleQuickAction('<%= item.actionLabel %>', '<%= item.projectCode %>')" type="button">
      <%= item.actionLabel %>
    </button>
  </div>
  <% }); %>
<% } %>
</div>
</div>
<!-- RIGHT: Recent Payments (4 cols = ~34%) -->
<div class="lg:col-span-4 flex flex-col bg-surface-container-low p-space-md gap-space-md shadow-sm">
<div class="flex items-center justify-between pb-space-xs">
<div class="flex items-center gap-space-sm">
<span class="material-symbols-outlined text-primary text-[22px]">history</span>
<h2 class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight">Recent Payments</h2>
</div>
<span class="px-space-xs py-0.5 bg-surface-container-highest text-outline font-label-sm text-label-sm uppercase">
  Latest (<%= payments.length %>)
</span>
</div>
<!-- Chronological Payments Feed -->
<div class="flex flex-col gap-space-sm">
<% if (payments.length === 0) { %>
  <div class="p-space-md bg-surface-container text-center flex flex-col items-center justify-center gap-space-xs text-outline">
    <span class="material-symbols-outlined text-[28px] text-primary/60">payments</span>
    <span class="font-label-lg text-on-surface">No Recent Payments Recorded</span>
    <span class="font-body-sm text-on-surface-variant">No client payments recorded in the ledger yet.</span>
  </div>
<% } else { %>
  <% payments.forEach(function(pay) { %>
  <div class="p-space-sm bg-surface-container flex flex-col gap-space-xs">
    <div class="flex items-center justify-between flex-wrap gap-1">
      <div class="flex items-center gap-space-xs">
        <span class="px-1.5 py-0.5 bg-primary-container text-on-primary-container font-label-sm text-label-sm font-semibold uppercase"><%= pay.paymentType %></span>
        <span class="font-label-md text-label-md font-semibold text-on-surface font-code-tabular">LKR <%= formatLKR(pay.amount) %></span>
      </div>
      <span class="font-label-sm text-label-sm text-outline font-code-tabular"><%= formatDateTime(pay.paymentDate) %></span>
    </div>
    <p class="font-body-sm text-body-sm text-on-surface-variant">
      <span class="font-code-tabular text-secondary"><%= pay.projectCode %></span> (<%= pay.customerName %>) —
      <span class="font-label-sm text-label-sm px-1 py-0.5 bg-surface-container-highest text-on-surface"><%= pay.paymentMethod %></span>
      <% if (pay.referenceNumber) { %>
        Ref: <span class="font-code-tabular text-on-surface"><%= pay.referenceNumber %></span>
      <% } else { %>
        Ref: <span class="text-outline">—</span>
      <% } %>
    </p>
  </div>
  <% }); %>
<% } %>
</div>
</div>
</div>

<!-- OUTSTANDING INVOICES DATA TABLE SECTION -->
<div class="flex flex-col bg-surface-container-low p-space-md gap-space-md shadow-sm">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pb-space-xs">
    <div class="flex items-center gap-space-sm">
      <span class="material-symbols-outlined text-primary text-[22px]">receipt_long</span>
      <h2 class="font-headline-sm text-headline-sm text-on-surface uppercase tracking-tight">Outstanding Invoices</h2>
    </div>
    <span class="px-space-sm py-0.5 bg-surface-container-highest text-on-surface font-label-sm text-label-sm uppercase tracking-wider">
      Unsettled Invoices (<%= invoices.length %>)
    </span>
  </div>
  <div class="w-full overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-surface-container font-label-sm text-label-sm uppercase tracking-wider text-outline">
          <th class="p-space-sm font-semibold">Invoice No.</th>
          <th class="p-space-sm font-semibold">Project</th>
          <th class="p-space-sm font-semibold">Customer</th>
          <th class="p-space-sm font-semibold">Invoice Date</th>
          <th class="p-space-sm font-semibold text-right">Total Amount (LKR)</th>
          <th class="p-space-sm font-semibold text-right">Advance Paid (LKR)</th>
          <th class="p-space-sm font-semibold text-right">Balance Due (LKR)</th>
          <th class="p-space-sm font-semibold text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-container-highest/20 font-body-sm text-body-sm">
      <% if (invoices.length === 0) { %>
        <tr>
          <td colspan="8" class="p-space-lg text-center text-outline font-body-sm">
            <div class="flex flex-col items-center justify-center gap-space-xs">
              <span class="material-symbols-outlined text-[32px] text-primary/60">check_circle</span>
              <span class="font-label-lg text-on-surface">No Outstanding Invoices</span>
              <span class="font-body-sm text-on-surface-variant">All issued client invoices have been fully settled.</span>
            </div>
          </td>
        </tr>
      <% } else { %>
        <% invoices.forEach(function(inv) { %>
        <tr class="hover:bg-surface-container/60 transition-colors">
          <td class="p-space-sm font-code-tabular text-primary font-semibold whitespace-nowrap">
            <%= inv.invoiceNumber %>
          </td>
          <td class="p-space-sm font-code-tabular text-secondary whitespace-nowrap">
            <%= inv.projectCode %>
          </td>
          <td class="p-space-sm text-on-surface whitespace-nowrap">
            <%= inv.customerName %>
          </td>
          <td class="p-space-sm font-code-tabular text-outline whitespace-nowrap">
            <%= formatDate(inv.invoiceDate) %>
          </td>
          <td class="p-space-sm font-code-tabular text-on-surface text-right whitespace-nowrap">
            <%= formatLKR(inv.totalAmount) %>
          </td>
          <td class="p-space-sm font-code-tabular text-outline text-right whitespace-nowrap">
            <%= formatLKR(inv.advancePaid) %>
          </td>
          <td class="p-space-sm font-code-tabular text-primary font-semibold text-right whitespace-nowrap">
            <%= formatLKR(inv.balanceAmount) %>
          </td>
          <td class="p-space-sm text-right whitespace-nowrap">
            <button class="px-space-sm py-1 bg-surface-container-highest hover:bg-primary-container hover:text-on-primary text-on-surface font-label-sm text-label-sm uppercase transition-colors cursor-pointer" onclick="openPaymentModalWithProject('<%= inv.projectCode %>')" type="button">
              Record Payment
            </button>
          </td>
        </tr>
        <% }); %>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- MODAL: RECORD PAYMENT QUICK ACTION -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-space-md bg-surface-container-lowest/80 backdrop-blur-sm hidden" id="paymentModal">
<div class="bg-surface-container-low max-w-lg w-full p-space-lg flex flex-col gap-space-md shadow-2xl relative border border-outline-variant/30 max-h-[90vh] overflow-y-auto">
<!-- Modal Header -->
<div class="flex items-start justify-between">
<div class="flex flex-col gap-space-xs">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-[20px]">payments</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface uppercase">Record Client Payment</h3>
</div>
<span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">
  Payment Management Quick Action
</span>
</div>
<button aria-label="Close modal" class="p-space-xs text-outline hover:text-on-surface hover:bg-surface-container transition-colors cursor-pointer" onclick="closePaymentModal()" type="button">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
<!-- Payment Form -->
<form class="flex flex-col gap-space-md" id="paymentForm" onsubmit="handlePaymentSubmit(event)">
<!-- Project Select -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="projectSelect">Target Project</label>
<select class="h-10 px-space-sm bg-surface-container text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="projectSelect" onchange="updateProjectCalculations()" required="">
<% if (invoices.length === 0) { %>
  <option value="" disabled selected>No unsettled invoices currently available</option>
<% } else { %>
  <% invoices.forEach(function(inv, idx) { %>
    <option value="<%= inv.projectCode %>" data-balance="<%= inv.balanceAmount %>" data-invoice="<%= inv.invoiceNumber %>" <%= idx === 0 ? 'selected' : '' %>>
      <%= inv.projectCode %> | <%= inv.projectName %> (<%= inv.invoiceNumber %>: LKR <%= formatLKR(inv.balanceAmount) %> Due)
    </option>
  <% }); %>
<% } %>
</select>
</div>
<!-- Project Status & Rules Notice Banner -->
<div class="p-space-sm bg-surface-container border-l-2 border-secondary flex flex-col gap-0.5" id="eligibilityNoticeContainer">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold" id="eligibilityNoticeTitle">Eligibility Status</span>
<p class="font-body-sm text-body-sm text-on-surface-variant" id="eligibilityNoticeText">Select an unsettled invoice to review outstanding balance. Actual ledger payment posting will be handled in the Payment Management module.</p>
</div>
<!-- Payment Type -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Payment Allocation Type</label>
<div class="grid grid-cols-2 gap-space-sm">
<label class="flex items-center gap-space-sm p-space-sm bg-surface-container cursor-pointer hover:bg-surface-container-high">
<input class="accent-primary" id="radioAdvance" name="paymentType" onchange="updateProjectCalculations()" type="radio" value="ADVANCE"/>
<span class="font-label-md text-label-md text-on-surface">30% Advance Deposit</span>
</label>
<label class="flex items-center gap-space-sm p-space-sm bg-surface-container cursor-pointer hover:bg-surface-container-high">
<input checked="" class="accent-primary" id="radioFinal" name="paymentType" onchange="updateProjectCalculations()" type="radio" value="FINAL"/>
<span class="font-label-md text-label-md text-on-surface">Final / Balance Payment</span>
</label>
</div>
</div>
<!-- Amount and Max helper -->
<div class="flex flex-col gap-space-xs">
<div class="flex items-center justify-between">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="paymentAmount">Amount (LKR)</label>
<span class="font-label-sm text-label-sm font-code-tabular text-secondary" id="maxBalanceHint">Outstanding Balance Due: LKR 0.00</span>
</div>
<div class="relative flex items-center">
<span class="absolute left-space-sm font-label-md text-label-md text-outline font-code-tabular">LKR</span>
<input class="w-full h-10 pl-12 pr-space-sm bg-surface-container text-on-surface font-code-tabular text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="paymentAmount" min="1" required="" type="number" value="0"/>
</div>
<span class="font-label-sm text-label-sm text-error hidden p-space-xs bg-error-container/20 border-l border-error" id="validationWarning"></span>
</div>
<!-- Payment Method (EXACTLY CASH and BANK_TRANSFER only) -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="paymentMethod">Payment Method</label>
<select class="h-10 px-space-sm bg-surface-container text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="paymentMethod" required="">
<option value="BANK_TRANSFER">BANK_TRANSFER</option>
<option value="CASH">CASH</option>
</select>
</div>
<!-- Reference / Voucher Note -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="voucherNote">Payment / Voucher Reference (Optional)</label>
<input class="h-10 px-space-sm bg-surface-container text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors placeholder:text-outline/60" id="voucherNote" placeholder="e.g., SL-TRX-XXXX or leave blank" type="text" value=""/>
</div>
<!-- Payment Evidence Upload -->
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-outline uppercase tracking-wider" for="evidenceUpload">Payment Evidence (Optional)</label>
<div class="flex items-center gap-space-sm">
<input class="block w-full text-body-sm text-outline file:mr-4 file:py-2 file:px-4 file:border-0 file:text-label-sm file:font-semibold file:bg-surface-container-high file:text-on-surface hover:file:bg-surface-container-highest cursor-pointer bg-surface-container" id="evidenceUpload" type="file"/>
</div>
</div>
<!-- Buttons -->
<div class="flex items-center justify-end gap-space-sm pt-space-xs">
<button class="px-space-md py-space-sm bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label-md text-label-md uppercase tracking-wider transition-colors cursor-pointer" onclick="closePaymentModal()" type="button">
  Cancel
</button>
<button class="px-space-md py-space-sm bg-primary-container hover:bg-secondary-container text-on-primary font-label-md text-label-md uppercase tracking-wider transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" id="submitPaymentBtn" type="submit">
  Confirm &amp; Post to Ledger
</button>
</div>
</form>
</div>
</div>
<!-- TOAST NOTIFICATION CONTAINER -->
<div class="fixed bottom-space-md right-space-md px-space-md py-space-sm bg-surface-container-highest text-on-surface font-body-md text-body-md shadow-xl transition-all duration-300 transform translate-y-12 opacity-0 pointer-events-none z-50 flex items-center gap-space-sm border border-outline-variant/40" id="toastMessage">
<span class="material-symbols-outlined text-secondary text-[20px]" id="toastIcon">check_circle</span>
<span id="toastText">Transaction updated successfully.</span>
</div>
</div>
<script>
  function toggleMobileMenu() {
    const sidebar = document.getElementById('sidebarDrawer');
    const backdrop = document.getElementById('mobileDrawerBackdrop');
    if (!sidebar || !backdrop) return;
    const isClosed = sidebar.classList.contains('-translate-x-full');
    if (isClosed) {
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('hidden');
    } else {
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('hidden');
    }
  }

  function openPaymentModal() {
    document.getElementById('paymentModal').classList.remove('hidden');
    updateProjectCalculations();
  }

  function openPaymentModalWithProject(projectCode) {
    const sel = document.getElementById('projectSelect');
    if (sel && projectCode) {
      for (let i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value === projectCode) {
          sel.selectedIndex = i;
          break;
        }
      }
    }
    openPaymentModal();
  }

  function closePaymentModal() {
    document.getElementById('paymentModal').classList.add('hidden');
    document.getElementById('validationWarning').classList.add('hidden');
  }

  function updateProjectCalculations() {
    const sel = document.getElementById('projectSelect');
    const hint = document.getElementById('maxBalanceHint');
    const amountInput = document.getElementById('paymentAmount');
    const warn = document.getElementById('validationWarning');
    const submitBtn = document.getElementById('submitPaymentBtn');

    warn.classList.add('hidden');

    if (!sel || !sel.selectedOptions || sel.selectedOptions.length === 0 || !sel.value) {
      hint.textContent = 'Outstanding Balance Due: LKR 0.00';
      amountInput.value = 0;
      submitBtn.disabled = true;
      return;
    }

    const opt = sel.selectedOptions[0];
    const balance = parseFloat(opt.dataset.balance) || 0;
    const invoiceNum = opt.dataset.invoice || '';

    hint.textContent = 'Outstanding Balance Due: LKR ' + balance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    amountInput.value = balance > 0 ? balance : 0;
    submitBtn.disabled = balance <= 0;
  }

  function handlePaymentSubmit(e) {
    e.preventDefault();
    closePaymentModal();
    showToast('Notice: Payment recording backend will be connected in the Payment Management module.');
  }

  function handleQuickAction(actionName, projectCode) {
    showToast(actionName + ' opened for ' + projectCode);
  }

  function openInvoiceNotification() {
    showToast('Redirecting to Invoice Management creation interface...');
  }

  function showToast(msg) {
    const t = document.getElementById('toastMessage');
    const txt = document.getElementById('toastText');
    if (!t || !txt) return;
    txt.textContent = msg;
    t.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
    t.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      t.classList.remove('translate-y-0', 'opacity-100');
      t.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
    }, 3800);
  }
</script></main></div></body></html>
